; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pocket Sandbox — NPR Diorama"
config/description="A Minecraft-flavoured sandbox exploration diorama rendered as a hand-made low-poly figurine: smooth faceted terrain, 3-band toon ramp, inverted-hull ink outlines, orthographic isometric light."
run/main_scene="res://scenes/dev/diorama.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Style="*res://scripts/core/style.gd"
Capture="*res://scripts/core/capture.gd"
Clock="*res://scripts/core/render_clock.gd"
; S0.3 batch 1 — order matters: `GameState._ready()` re-roots `Rng`, so `Rng` must
; already exist.  `s0_3_state` asserts this sequence rather than trusting it.
Rng="*res://scripts/core/rng.gd"
EventBus="*res://scripts/core/event_bus.gd"
GameState="*res://scripts/core/game_state.gd"
; S0.3 batch 2 — `SaveSystem` reads and writes `GameState.snapshot()`, so it comes
; last.  It has no `_ready`, subscribes to nothing and writes no file until a save
; is requested (ROADMAP §3.5 "不做自动存档"); `s0_3_no_autosave` asserts that.
SaveSystem="*res://scripts/core/save_system.gd"
; S0.3 batch 3 — the only node allowed to call `change_scene_to_file()` (the spec guard
; rule `scene_change_owner` enforces that).  It has no `_ready` and no `_process`, so its
; position in this list carries no ordering requirement.
SceneRouter="*res://scripts/core/scene_router.gd"
; S0.4 batch 2 — debug overlay + `F1`/`F3` (ROADMAP §5 S0.4).  Own hidden CanvasLayer, so
; its position carries no ordering requirement either.  The hotkeys are registered only
; under `OS.is_debug_build()`; that gate lives in `scripts/core/input_setup.gd` alone.
Debug="*res://scripts/core/debug_layer.gd"

[shader_globals]

; S0.6 — one injectable time for every animated shader, so a screenshot is
; byte-reproducible.  Written every frame by scripts/core/render_clock.gd and read
; by shaders/common/toon.gdshader (vegetation sway) and
; shaders/terrain/water.gdshader (waves).  Replaces the builtin TIME, which
; follows real engine time and cannot be frozen.
render_time={
"type": "float",
"value": 0.0
}

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/16_bits=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.5608, 0.8431, 0.949, 1)
anti_aliasing/quality/screen_space_aa=1
