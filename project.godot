; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pocket Sandbox — NPR Diorama"
config/description="A Minecraft-flavoured sandbox exploration diorama rendered as a hand-made low-poly figurine: smooth faceted terrain, 3-band toon ramp, inverted-hull ink outlines, orthographic isometric light."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Style="*res://scripts/style.gd"
Capture="*res://scripts/capture.gd"
Clock="*res://scripts/render_clock.gd"

[shader_globals]

; S0.6 — one injectable time for every animated shader, so a screenshot is
; byte-reproducible.  Written every frame by scripts/render_clock.gd and read by
; shaders/toon.gdshader (vegetation sway) and shaders/water.gdshader (waves).
; Replaces the builtin TIME, which follows real engine time and cannot be frozen.
render_time={
"type": "float",
"value": 0.0
}

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/16_bits=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.5608, 0.8431, 0.949, 1)
anti_aliasing/quality/screen_space_aa=1
